PJ360_ENVIRONMENT=local
PJ360_LOG_LEVEL=INFO
PJ360_DATABASE_PATH=data/processed/propertyjourney360.db
PJ360_POSTGRES_DSN=postgresql://pj360:local-development-only@127.0.0.1:5432/propertyjourney360
PJ360_AUTH_MODE=local_disabled

# Required only for cloud mode. Store the real value in Secret Manager.
PJ360_API_TOKEN=
PJ360_PROJECT_ID=
PJ360_LOCATION=australia-southeast1
PJ360_CORE_DATASET=
PJ360_MARTS_DATASET=
PJ360_GOVERNANCE_DATASET=
PJ360_QUERY_MAXIMUM_BYTES_BILLED=1000000000

# Salesforce Connected App. Store real values in a local secret store, never here.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=65.0

# GCP deployment settings.
GCP_PROJECT_ID=
GCP_REGION=australia-southeast1
GCS_RAW_BUCKET=
BIGQUERY_LOCATION=australia-southeast1
DBT_BIGQUERY_PROJECT=
DBT_BIGQUERY_DATASET=propertyjourney_dev
DBT_BIGQUERY_RAW_DATASET=
DBT_BIGQUERY_STAGING_DATASET=
DBT_BIGQUERY_CORE_DATASET=
DBT_BIGQUERY_MARTS_DATASET=
DBT_BIGQUERY_GOVERNANCE_DATASET=
PUBSUB_EMULATOR_HOST=localhost:8085
